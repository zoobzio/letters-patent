{
  "name": "@letters-patent/nuxt",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/letters-patent.git",
    "directory": "integrations/nuxt"
  },
  "type": "module",
  "main": "./.dist/module.mjs",
  "types": "./.dist/module.d.mts",
  "exports": {
    ".": {
      "types": "./.dist/module.d.mts",
      "import": "./.dist/module.mjs"
    },
    "./server": {
      "types": "./.dist/server/handlers.d.mts",
      "import": "./.dist/server/handlers.mjs"
    },
    "./constant": {
      "types": "./.dist/constant.d.mts",
      "import": "./.dist/constant.mjs"
    }
  },
  "files": [
    ".dist"
  ],
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "letters-patent": "workspace:*",
    "h3": "catalog:"
  },
  "devDependencies": {
    "@nuxt/schema": "catalog:"
  }
}

{
  "name": "crestable",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/crestable.git",
    "directory": "packages/crestable"
  },
  "type": "module",
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/index.mjs"
    },
    "./kit": {
      "types": "./.dist/kit.d.ts",
      "import": "./.dist/kit.mjs"
    },
    "./config": {
      "types": "./.dist/config.d.ts",
      "import": "./.dist/config.mjs"
    }
  },
  "files": [
    ".dist"
  ],
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@crestable/core": "workspace:*",
    "@crestable/kit": "workspace:*",
    "@crestable/schema": "workspace:*"
  }
}

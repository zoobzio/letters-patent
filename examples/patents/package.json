{
  "name": "@letters-patent/example-patents",
  "private": true,
  "type": "module",
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.mts",
      "import": "./.dist/index.mjs"
    },
    "./config": {
      "types": "./.dist/config.d.mts",
      "import": "./.dist/config.mjs"
    },
    "./manifest": {
      "types": "./.dist/manifest.d.mts",
      "import": "./.dist/manifest.mjs"
    },
    "./issuers": {
      "types": "./.dist/issuers.d.mts",
      "import": "./.dist/issuers.mjs"
    },
    "./issuers/*": {
      "types": "./.dist/issuers/*.d.mts",
      "import": "./.dist/issuers/*.mjs"
    },
    "./resource.json": "./.dist/resource.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "patent build",
    "stub": "patent build",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "letters-patent": "workspace:*"
  },
  "devDependencies": {
    "@letters-patent/kit": "workspace:*",
    "@types/node": "catalog:"
  }
}
